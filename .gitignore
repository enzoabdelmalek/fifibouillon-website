# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Originaux d'appareil photo : 68 Mo, jusqu'à 8064 px de large. Le site n'en
# sert jamais plus de 1200. Les versions réduites vivent dans public/photos.
public/assets/photos/

# Photos réduites mais pas encore placées : elles ne servent à rien tant
# qu'on ne sait pas ce qu'elles montrent, et public/ est servi au public.
design/photos-a-identifier/
